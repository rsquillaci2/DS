# === Credenciais e Configuração ===

# DataJud (CNJ) — obter em https://datajud-wiki.cnj.jus.br/
DATAJUD_API_KEY=your_key_here

# CVM — acesso público, sem chave
# SOF/MPO — acesso público, sem chave
# DJEN API Comunica — acesso público, sem chave

# === Rate Limits (requests por minuto) ===
DATAJUD_RATE_LIMIT=30
DJEN_RATE_LIMIT=60
CVM_RATE_LIMIT=60
SOF_RATE_LIMIT=60

# === Banco de Dados ===
DUCKDB_PATH=data/precatorios.duckdb

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
